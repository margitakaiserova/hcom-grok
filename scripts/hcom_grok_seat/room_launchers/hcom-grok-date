#!/usr/bin/env bash
# hcom-grok-date: start or operate a Grok seat in the Date HCOM room.
# Does not open a new Ghostty window.
set -euo pipefail
unset NO_COLOR
export FORCE_COLOR=1
export CLICOLOR=1
export COLORTERM=truecolor
PROJECT="/Volumes/Atlas/___/Modernised/___DATE_CALCULATIONS"
export HCOM_DIR="/Users/maneeshpatel/.hcom-rooms/room-1"
cd "$PROJECT"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
exec "$HOME/.local/bin/hcom-grok" "$@"
